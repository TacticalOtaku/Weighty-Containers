<footer class="cr-footer">
  <button type="button" class="cr-button cr-button-secondary" data-action="cancel">
    {{#if readOnly}}{{localize "weighty-containers.configDialog.close"}}{{else}}{{localize "weighty-containers.configDialog.cancel"}}{{/if}}
  </button>
  {{#unless readOnly}}
  <button type="submit" class="cr-button cr-button-primary" data-save-button>
    <i class="fas fa-floppy-disk" aria-hidden="true"></i>
    <span>{{localize "weighty-containers.configDialog.save"}}</span>
  </button>
  {{/unless}}
</footer>
