<footer class="cr-footer">
  <div class="cr-theme" role="group"
       aria-label="{{localize 'WC.theme.label'}}">
    {{#each themeOptions}}
    <button type="button" class="cr-theme-option" data-action="setTheme"
            data-theme="{{this.value}}" aria-pressed="{{this.active}}"
            aria-label="{{this.label}}" data-tooltip="{{this.label}}">
      <i class="{{this.icon}}" aria-hidden="true"></i>
    </button>
    {{/each}}
  </div>

  <div class="cr-footer-actions">
    <button type="button" class="cr-btn cr-btn-text anvil-interactive" data-action="cancel">
      {{#if readOnly}}
        {{localize "WC.configDialog.close"}}
      {{else}}
        {{localize "WC.configDialog.cancel"}}
      {{/if}}
    </button>
    {{#unless readOnly}}
    <button type="submit" class="cr-btn cr-btn-filled anvil-interactive" data-save-button>
      <i class="fa-solid fa-check" aria-hidden="true"></i>
      <span>{{localize "WC.configDialog.save"}}</span>
    </button>
    {{/unless}}
  </div>
</footer>
