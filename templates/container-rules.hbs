{{!--
  Container rules.

  The reduction is this module's whole reason to exist, so it lives in a
  permanent hero rather than behind a tab. Everything that is a refinement of
  it — presets, content restrictions, property rules — sits in tabbed panes, so
  the window is never a long scroll with a scroll-spy pretending to be
  navigation. The rule summary is pinned above the footer: it answers "what did
  I just build" and should not have to be scrolled to.
--}}

<div class="cr-shell">

  <header class="cr-hero">
    <div class="cr-hero-id">
      <span class="cr-hero-icon" aria-hidden="true"><i class="fas fa-box-open"></i></span>
      <span class="cr-hero-copy">
        <small>{{localize "weighty-containers.configDialog.containerLabel"}}</small>
        <strong title="{{containerName}}">{{containerName}}</strong>
      </span>
    </div>

    <div class="cr-dial">
      <div class="cr-dial-head">
        <span class="cr-dial-label">{{localize "weighty-containers.reductionDialog.label"}}</span>
        <label class="cr-dial-value">
          <input type="number" name="reductionPct" value="{{reductionPct}}"
                 min="0" max="100" step="1"
                 aria-label="{{localize 'weighty-containers.reductionDialog.label'}}">
          <span aria-hidden="true">%</span>
        </label>
      </div>
      <input type="range" name="reductionRange" value="{{reductionPct}}" min="0" max="100" step="1"
             aria-label="{{localize 'weighty-containers.reductionDialog.label'}}">
      <div class="cr-dial-scale" aria-hidden="true"><span>0</span><span>50</span><span>100</span></div>
    </div>

    <div class="cr-readout" aria-live="polite">
      <small>
        <i class="fas fa-scale-balanced" aria-hidden="true"></i>
        {{#if previewIsActual}}
          {{localize "weighty-containers.configDialog.previewContents"}}
        {{else}}
          {{localize "weighty-containers.configDialog.previewWeight"}}
        {{/if}}
      </small>
      <strong>
        <span class="cr-readout-before">{{previewBefore}}</span>
        <i class="fas fa-arrow-right-long" aria-hidden="true"></i>
        <b data-preview-after>{{previewAfter}}</b>
        <em>{{previewUnit}}</em>
      </strong>
    </div>
  </header>

  {{#if readOnly}}
  <p class="cr-readonly-banner">
    <i class="fas fa-eye" aria-hidden="true"></i>
    <span>{{localize "weighty-containers.configDialog.readOnly"}}</span>
  </p>
  {{/if}}

  <nav class="cr-tabs" role="tablist"
       aria-label="{{localize 'weighty-containers.configDialog.navigation'}}">
    {{#each tabs}}
    <button type="button" class="cr-tab{{#if this.active}} is-active{{/if}}"
            role="tab" id="cr-tab-{{this.id}}"
            aria-selected="{{this.active}}" aria-controls="cr-pane-{{this.id}}"
            data-action="selectTab" data-tab="{{this.id}}">
      <i class="{{this.icon}}" aria-hidden="true"></i>
      <span>{{this.label}}</span>
      {{#if this.badge}}
      <span class="cr-tab-badge" data-nav-badge="{{this.badge}}" hidden></span>
      {{/if}}
    </button>
    {{/each}}
    <span class="cr-tab-marker" aria-hidden="true"></span>
  </nav>

  <div class="cr-panes anvil-scroll">

    {{#if presets}}
    <section class="cr-pane" data-tab="presets" role="tabpanel"
             aria-labelledby="cr-tab-presets" tabindex="0">
      <p class="cr-pane-lede">{{localize "weighty-containers.presets.hint"}}</p>
      <div class="cr-preset-grid">
        {{#each presets}}
        <button type="button" class="cr-preset anvil-interactive"
                data-action="applyPreset" data-preset-id="{{this.id}}">
          <span class="cr-preset-icon" aria-hidden="true"><i class="{{this.icon}}"></i></span>
          <span class="cr-preset-copy">
            <span class="cr-preset-label">{{this.label}}</span>
            {{#if this.summary}}<small class="cr-preset-summary">{{this.summary}}</small>{{/if}}
          </span>
        </button>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <section class="cr-pane" data-tab="restrictions" role="tabpanel"
             aria-labelledby="cr-tab-restrictions" tabindex="0">
      <div class="cr-field">
        <div class="cr-field-label">
          {{localize "weighty-containers.configDialog.allowedTypes.label"}}
        </div>
        {{{allowedTypesSelect}}}
        <p class="cr-hint">{{localize "weighty-containers.configDialog.allowedTypes.shortHint"}}</p>
      </div>

      <div class="cr-field">
        <div class="cr-field-label">
          {{localize "weighty-containers.configDialog.allowedSubtypes.label"}}
        </div>
        {{{allowedSubtypesSelect}}}
        <p class="cr-hint">{{localize "weighty-containers.configDialog.allowedSubtypes.shortHint"}}</p>
        <div class="cr-notice cr-notice-warn" data-subtype-warning hidden>
          <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
          <span data-warning-text></span>
          <span class="cr-notice-actions">
            <button type="button" data-action="showUnavailable">
              {{localize "weighty-containers.configDialog.actions.show"}}
            </button>
            <button type="button" data-action="removeUnavailable">
              {{localize "weighty-containers.configDialog.actions.removeUnavailable"}}
            </button>
          </span>
        </div>
      </div>
    </section>

    <section class="cr-pane" data-tab="properties" role="tabpanel"
             aria-labelledby="cr-tab-properties" tabindex="0">
      <div class="cr-duo">
        <div class="cr-field cr-field-positive">
          <div class="cr-field-label">
            <span class="cr-field-mark" aria-hidden="true"><i class="fas fa-circle-check"></i></span>
            {{localize "weighty-containers.configDialog.requiredProperties.label"}}
            <span class="cr-info" tabindex="0"
                  data-tooltip="{{localize 'weighty-containers.configDialog.requiredProperties.hint'}}">
              <i class="fas fa-circle-info" aria-hidden="true"></i>
            </span>
          </div>
          {{{requiredPropertiesSelect}}}
          <p class="cr-hint">{{localize "weighty-containers.configDialog.requiredProperties.shortHint"}}</p>
          <p class="cr-field-error" data-property-error="requiredProperties" hidden></p>
        </div>

        <div class="cr-field cr-field-negative">
          <div class="cr-field-label">
            <span class="cr-field-mark" aria-hidden="true"><i class="fas fa-circle-xmark"></i></span>
            {{localize "weighty-containers.configDialog.forbiddenProperties.label"}}
            <span class="cr-info" tabindex="0"
                  data-tooltip="{{localize 'weighty-containers.configDialog.forbiddenProperties.hint'}}">
              <i class="fas fa-circle-info" aria-hidden="true"></i>
            </span>
          </div>
          {{{forbiddenPropertiesSelect}}}
          <p class="cr-hint">{{localize "weighty-containers.configDialog.forbiddenProperties.shortHint"}}</p>
          <p class="cr-field-error" data-property-error="forbiddenProperties" hidden></p>
        </div>
      </div>

      <div class="cr-field">
        <div class="cr-field-label">{{localize "weighty-containers.configDialog.matchMode.label"}}</div>
        <div class="cr-segmented" role="radiogroup"
             aria-label="{{localize 'weighty-containers.configDialog.matchMode.label'}}">
          <label>
            <input type="radio" name="propertyMatchMode" value="all" {{#if modeAll}}checked{{/if}}>
            <span><i class="fas fa-circle-check" aria-hidden="true"></i>
              {{localize "weighty-containers.configDialog.matchMode.all"}}</span>
          </label>
          <label>
            <input type="radio" name="propertyMatchMode" value="any" {{#if modeAny}}checked{{/if}}>
            <span><i class="fas fa-circle-half-stroke" aria-hidden="true"></i>
              {{localize "weighty-containers.configDialog.matchMode.any"}}</span>
          </label>
        </div>
        <p class="cr-hint">{{localize "weighty-containers.configDialog.matchMode.hint"}}</p>
      </div>
    </section>
  </div>

  <section class="cr-summary" aria-live="polite">
    <span class="cr-summary-mark" aria-hidden="true"><i class="fas fa-list-check"></i></span>
    <div class="cr-summary-body">
      <small>{{localize "weighty-containers.configDialog.summary.title"}}</small>
      <div data-rule-summary></div>
    </div>
  </section>
</div>
